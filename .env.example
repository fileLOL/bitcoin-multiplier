# Copia este archivo a .env si tu entorno carga dotenv (el servidor Node nativo no lo carga automáticamente).
# En Windows PowerShell, define estas variables en la sesión antes de ejecutar npm start.
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=pon_aqui_tu_usuario_rpc
BITCOIN_RPC_PASSWORD=pon_aqui_una_contrasena_rpc_larga
API_TOKEN=crea_un_token_largo_aleatorio
PORT=3000
HOST=127.0.0.1
